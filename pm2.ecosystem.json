{
  "apps": [
    {
      "name": "outreachos-wa",
      "script": "wa-sender.js",
      "watch": false,
      "instances": 1,
      "exec_mode": "fork",
      "restart_delay": 5000,
      "max_restarts": 10,
      "env": {
        "NODE_ENV": "production"
      }
    },
    {
      "name": "outreachos-voice",
      "script": "voice-worker.js",
      "watch": false,
      "instances": 1,
      "exec_mode": "fork",
      "restart_delay": 5000,
      "max_restarts": 10,
      "env": {
        "PORT": "3001",
        "NODE_ENV": "production"
      }
    }
  ]
}
