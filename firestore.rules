rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only authenticated users can read/write any document.
    // For production, add role-based checks using custom claims.
    // Example: request.auth.token.role == 'admin'

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Voice callback endpoint writes to voiceLogs from a server process
    // (server-to-server with service account — handled via admin SDK, bypasses rules)
  }
}
